# Node
NODE_ENV=development

# Database (local/non-docker dev — docker-compose overrides this to the "postgres" hostname)
DATABASE_URL=postgresql://vinted:vinted@localhost:5432/vinted_hunter?schema=public

# Database schema used by apps/api integration tests (fastify.inject() against real Postgres) —
# same host/creds as DATABASE_URL, isolated by Postgres schema so dev data is never touched
DATABASE_URL_TEST=postgresql://vinted:vinted@localhost:5432/vinted_hunter?schema=test

# Redis (local/non-docker dev — docker-compose overrides this to the "redis" hostname)
REDIS_URL=redis://localhost:6379

# Crawler (apps/worker + packages/crawler) — §11.7
VINTED_BASE_URL=https://www.vinted.fr
MAX_WORKERS=5
REQUEST_DELAY_MIN=3000
REQUEST_DELAY_MAX=8000
CACHE_DURATION=24H

# Auth — wired up in Phase 2
JWT_SECRET=
COOKIE_SECRET=
CORS_ORIGIN=http://localhost:3000

# AI providers — not used by Phase 5's rule-based analyzer (packages/analyzer); reserved for
# Phase 6's vision/OCR work
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Notifications (apps/worker + packages/notifications) — §46-49. Leave a channel's vars empty
# to skip it; at least one must be set for any push to actually go out.
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Billing — SaaS phase, not in V1 roadmap
STRIPE_SECRET=

# App ports
API_PORT=3001
DASHBOARD_PORT=3000

# Dashboard — must be the browser-reachable API origin (inlined into the client bundle at
# build time, see apps/dashboard/Dockerfile)
NEXT_PUBLIC_API_URL=http://localhost:3001
