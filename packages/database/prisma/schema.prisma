generator client {
  provider      = "prisma-client-js"
  // Pinned explicitly (not just "native") — apps/worker runs on Debian slim (openssl 3.0.x) and
  // apps/api/dashboard run on Alpine (musl); relying on build-time "native" detection alone has
  // produced a mismatched engine before when Docker layer caching reused a generate step from a
  // differently-based image.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  PRO
  ENTERPRISE
}

enum Marketplace {
  VINTED
}

enum PurchaseStatus {
  PENDING
  SOLD
  CANCELLED
}

enum NotificationChannel {
  DISCORD
  TELEGRAM
  EMAIL
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  firstname        String?
  role             UserRole       @default(USER)
  // Per-user notification channels (replaces the old global DISCORD_WEBHOOK/TELEGRAM_TOKEN/
  // TELEGRAM_CHAT_ID env vars) — apps/worker's send-notification.job.ts looks these up per
  // search owner instead of using one shared destination for every user.
  discordWebhook   String?
  telegramBotToken String?
  telegramChatId   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  searches         Search[]
  notifications    Notification[]
  purchases        Purchase[]
  refreshTokens    RefreshToken[]
  favorites        Favorite[]

  @@map("users")
}

model Search {
  id               String   @id @default(uuid())
  userId           String
  name             String
  brands           String[]
  categories       String[]
  sizes            String[]
  keywords         String[]
  excludedKeywords String[]
  minPrice         Float?
  maxPrice         Float?
  minimumScore     Int      @default(70)
  // Target resale margin used to derive Analysis.maxBuyPrice (§ "best buy price"): the highest
  // price to pay for a match under this search so a resale at the estimated market value still
  // clears this ROI. Percentage, e.g. 30 means +30%.
  targetRoi        Int      @default(30)
  frequency        Int
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("searches")
}

model Listing {
  id            String         @id @default(uuid())
  externalId    String         @unique
  source        Marketplace
  title         String
  description   String?
  brand         String?
  category      String?
  size          String?
  condition     String?
  price         Float
  currency      String
  url           String
  images        String[]
  sellerId      String?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  seller        Seller?        @relation(fields: [sellerId], references: [id])
  analysis      Analysis?
  priceHistory  PriceHistory[]
  purchases     Purchase[]
  notifications Notification[]
  favoritedBy   Favorite[]

  @@index([sellerId])
  @@index([source])
  @@map("listings")
}

model Seller {
  id            String    @id @default(uuid())
  externalId    String    @unique
  username      String
  rating        Float?
  reviews       Int?
  accountAge    Int?
  totalListings Int?
  riskScore     Int?
  listings      Listing[]

  @@map("sellers")
}

model Analysis {
  id                String   @id @default(uuid())
  listingId         String   @unique
  score             Int
  priceScore        Int
  brandScore        Int
  conditionScore    Int
  liquidityScore    Int
  authenticityScore Int
  estimatedValue    Float
  estimatedProfit   Float
  roi               Float
  // Highest price to pay so a resale at estimatedValue still clears the triggering search's
  // targetRoi — derived once at analysis time from whichever search first discovered this
  // listing (Analysis is 1:1 with Listing, computed only once on discovery; see
  // apps/worker/src/jobs/crawl-search.job.ts).
  maxBuyPrice       Float
  explanation       Json
  createdAt         DateTime @default(now())
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Phase 6 (§13/§61/§62): Claude Vision output — nullable/best-effort, absent when the
  // listing had no images, ANTHROPIC_API_KEY was unset, or the vision call failed.
  photoQualityScore    Int?
  defects              Json?
  extractedLabelText   Json?
  brandLogoConsistent  Boolean?
  counterfeitRiskFlags Json?
  visionAnalyzedAt     DateTime?

  @@map("analyses")
}

model PriceHistory {
  id        String   @id @default(uuid())
  listingId String
  price     Float
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("price_history")
}

model Purchase {
  id            String         @id @default(uuid())
  userId        String
  listingId     String
  purchasePrice Float
  sellingPrice  Float?
  profit        Float?
  status        PurchaseStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing       Listing        @relation(fields: [listingId], references: [id])

  @@index([userId])
  @@index([listingId])
  @@map("purchases")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  listingId String
  channel   NotificationChannel
  sent      Boolean             @default(false)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing             @relation(fields: [listingId], references: [id])

  @@index([userId])
  @@index([listingId])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
  @@map("favorites")
}
