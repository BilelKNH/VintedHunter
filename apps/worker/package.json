{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@vinted-hunter/ai-engine": "workspace:*",
    "@vinted-hunter/analyzer": "workspace:*",
    "@vinted-hunter/crawler": "workspace:*",
    "@vinted-hunter/database": "workspace:*",
    "@vinted-hunter/notifications": "workspace:*",
    "@vinted-hunter/pricing-engine": "workspace:*",
    "@vinted-hunter/shared": "workspace:*",
    "bullmq": "^6.0.5",
    "ioredis": "^5.4.0",
    "playwright": "^1.49.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "^7.0.2",
    "tsx": "^4.19.0",
    "vitest": "^4.1.10"
  }
